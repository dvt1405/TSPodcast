# Served byte-for-byte by Firebase Hosting (AdMob verifies app-ads.txt); never convert to CRLF.
site/app-ads.txt text eol=lf
site/robots.txt text eol=lf
# Inline scripts are pinned by sha256 in the CSP (firebase.json); CRLF would change the hash and
# the browser would block them (no reveal animation). Keep the whole product site LF.
site/** text eol=lf
