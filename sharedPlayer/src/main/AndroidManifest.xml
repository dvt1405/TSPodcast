<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application tools:node="merge">
        <service
            android:name=".service.PlayerSessionService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <!--
                MediaLibraryService: the session plus a browse tree (car phase). The legacy
                MediaBrowserService action is what Android Auto and Android Automotive OS look
                for; media3 answers both. See docs/planned/plans/android-auto.md.
            -->
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>