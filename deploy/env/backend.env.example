# /etc/tspodcast/backend.env — environment of postgres, api and worker
# (compose profile "backend"). Owner root:tspodcast, chmod 640. Never commit it.
# Only needed once backend/ exists (docs/plans/ke-hoach-backend-quickwin-cuoc-lon.md).
#
# INVARIANT (plan §1): this file must NEVER contain PODCASTINDEX_* (no backend
# container may hold a PodcastIndex key) nor ANTHROPIC_API_KEY (the web's AI key
# stays in web.env). deploy.sh refuses to start if it finds them here.
#
# TODO(BE-M0): reconcile the names below with backend/ once it is written.

# --- Postgres (read by the postgres image on first init) ---
POSTGRES_DB=tspodcast
POSTGRES_USER=tspodcast
# Generate on the VPS: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=

# --- api + worker ---
# postgres://tspodcast:<POSTGRES_PASSWORD>@postgres:5432/tspodcast
# (host "postgres" is the compose service on the internal backend network)
DATABASE_URL=

# Public origin of the API, e.g. https://api.example.com
API_PUBLIC_URL=
# Contact address in the crawler User-Agent (plan §2.2: TSPodcastBot/1.0 (+https://<domain>/bot; bot@<domain>)).
CRAWLER_CONTACT_EMAIL=

# Firebase App Check (plan §2.5): project number and allowed app IDs
# (Firebase console > Project settings). Not secret, but environment-specific.
FIREBASE_PROJECT_NUMBER=
APP_CHECK_ALLOWED_APP_IDS=
# monitor | enforce
APP_CHECK_MODE=monitor

# API key the web server uses to call the api (plan §2.5 "Web dùng API key phía
# server"). Generate: openssl rand -hex 32. The same value goes into web.env
# under the name chosen by the web code (TODO when the web starts calling /v1).
WEB_API_KEY=

# Cloudflare R2 (backups, static JSON export). Cloudflare dashboard > R2 >
# Manage API tokens: a token limited to the TSPodcast bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Gemini (AI proxy of the api, after 05/2027). Google AI Studio > API keys.
GEMINI_API_KEY=

# Alerts (plan §2.6): Telegram bot token + chat id, healthchecks.io ping URLs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEALTHCHECKS_CRAWL_URL=
