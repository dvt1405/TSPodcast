# /etc/tspodcast/compose.env — values Docker Compose substitutes into
# deploy/docker-compose.yml. NOT secret, NOT passed into containers as a whole.
# Owner root:tspodcast, chmod 640 (bootstrap-vps.sh sets this).
# Never put API keys or passwords here: they belong in web.env / backend.env.

# Apex domain of the site, without scheme or "www." (e.g. example.com).
# DNS: A/AAAA for DOMAIN and www.DOMAIN (and api.DOMAIN for the backend) -> VPS.
DOMAIN=
# Email for the Let's Encrypt account (expiry and problem notices).
ACME_EMAIL=

# Image of the web, without tag. CI pushes ghcr.io/<github owner, lowercase>/tspodcast-web.
# The tag is not set here: deploy.sh keeps it in /var/lib/tspodcast/web.tag.
WEB_IMAGE=
# UI language baked into an image built on the server (deploy.sh --build): vi or en.
# CI uses the GitHub variable SITE_LOCALE instead.
SITE_LOCALE=vi

# Leave empty for the web only. Set to "backend" once backend/ exists to also
# run postgres, api and worker (docs/done/deploy/README.md §9).
COMPOSE_PROFILES=

# Optional: pin images (defaults in docker-compose.yml).
# CADDY_IMAGE=caddy:2-alpine
# POSTGRES_IMAGE=postgres:17-alpine
# TODO(BE-M2): set when CI publishes the backend images.
# API_IMAGE=ghcr.io/<owner>/tspodcast-api
# API_TAG=
# WORKER_IMAGE=ghcr.io/<owner>/tspodcast-worker
# WORKER_TAG=

# Optional: dead-man's switch for the nightly backup (healthchecks.io check URL).
# backup-postgres.sh pings it on success and <url>/fail on failure.
# BACKUP_PING_URL=
