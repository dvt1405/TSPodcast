# /etc/tspodcast/web.env — runtime environment of the web container.
# Owner root:tspodcast, chmod 640. Never commit the filled-in file.
# Format: KEY=value, one per line, no "export". Docker Compose expands $VAR in
# unquoted and double-quoted values: if a secret contains "$", wrap it in
# single quotes, e.g. PODCASTINDEX_API_SECRET='ab$cd' (single quotes are literal).
# Details of every variable: web/README.md "Biến môi trường".

# --- Server-only secrets (never reach the browser) ---
# PodcastIndex key pair. Required. Ask for a separate pair for the web at
# https://api.podcastindex.org/ (do not reuse the Android app's key).
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
# Optional User-Agent sent to PodcastIndex (default TSSPodcast/Web).
PODCASTINDEX_USER_AGENT=

# Claude API key from console.anthropic.com (set a monthly spend limit there).
# Leave empty to turn the AI features off (/api/ai/* answers 503).
ANTHROPIC_API_KEY=
# Optional, default claude-sonnet-5-5.
ANTHROPIC_MODEL=
# Optional: "off" behind a gateway that rejects the server-side fallback beta.
ANTHROPIC_FALLBACKS=

# --- Public settings read at runtime ---
# Search Console HTML-tag verification token (Search Console > Settings > Ownership).
GOOGLE_SITE_VERIFICATION=
# Exact app-ads.txt line(s) from AdMob; several lines separated by \n.
APP_ADS_TXT=
# SHA-256 fingerprints for /.well-known/assetlinks.json, comma-separated
# (Play Console > Setup > App signing: app signing key, plus upload key).
ANDROID_CERT_SHA256=

# --- Build-time only, NOT read from here ---
# NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_SITE_LOCALE and SITE_NOINDEX are baked into
# the image when it is built (Next.js inlines them). CI takes them from the
# GitHub variables SITE_URL / SITE_LOCALE; deploy.sh --build from compose.env.
# Setting them in this file has no effect.
