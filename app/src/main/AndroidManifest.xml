<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Podcast"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|orientation|screenLayout"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Podcast"
            tools:ignore="UnusedAttribute">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!--
                Fired only by this app's own PendingIntents (media notification
                and MediaSession activity). BROWSABLE was removed: it is
                meaningless on a non-VIEW action and only served to make this
                entry point reachable from other apps' links.
            -->
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT" />

                <action android:name="tss.t.action_from_notification" />

                <data android:scheme="tss" />
                <data android:host="ts.podcast" />
                <data android:path="/home" />
                <data android:path="/playing" />
                <data android:path="/playing/" />
            </intent-filter>
        </activity>
        <service
            android:name="tss.t.sharedplayer.service.PlayerSessionService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <!--
                MediaLibraryService: the session plus a browse tree (car phase). The legacy
                MediaBrowserService action is what Android Auto and Android Automotive OS look
                for; media3 answers both. See docs/planned/plans/android-auto.md.
                No android:permission: the car hosts must be able to bind; callers are
                filtered in PlayerSessionService.onGetSession instead.
            -->
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <!-- Android Auto: this app is a media app (res/xml/automotive_app_desc.xml). -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- Small icon Android Auto uses for this app's notifications. -->
        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@drawable/ic_stat_tspodcast" />
        <!-- Brand status-bar silhouette for FCM pushes (sharedFirebase defaults to ic_heart). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_tspodcast"
            tools:replace="android:resource" />
    </application>

</manifest>