<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup/transfer rules for API 31+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   This file was previously all comments, which meant the platform default
   applied and every shared-preferences file was backed up - including
   encrypted stores that cannot be decrypted after a restore.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="JsoupExt.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="JsoupExt.xml"/>
    </device-transfer>
</data-extraction-rules>
