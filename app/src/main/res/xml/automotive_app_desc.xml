<!--
    Android Auto: declares TSPodcast as a media app. Referenced by the
    com.google.android.gms.car.application meta-data in AndroidManifest.xml.
    The browse tree comes from PlayerSessionService (MediaLibraryService).
-->
<automotiveApp>
    <uses name="media" />
</automotiveApp>
