    <string name="select_favourite_category_screen_title">좋아하는 주제</string>
    <string name="select_favourite_category_screen_description">(3개 이상 선택)</string>
    <string name="select_favourite_category_screen_btn_confirm_title">저장하고 계속하기</string>

    <!-- Intro (brand tones) -->
    <string name="onboarding_next">계속</string>
    <string name="onboarding_skip">건너뛰기</string>

    <!-- Privacy step -->
    <string name="privacy_title">개인정보 보호</string>
    <string name="privacy_intro">시작하기 전에 TSPodcast가 정보를 어떻게 처리하는지 정확히 알려 드리고, 직접 결정하실 수 있도록 해 드릴게요.</string>
    <string name="privacy_not_collected_title">수집하지 않는 정보</string>
    <string name="privacy_not_collected_body">이름, 이메일, 전화번호, 연락처, 정확한 위치, 기기 식별자(ANDROID_ID). 계정을 만들 필요가 없어요.</string>
    <string name="privacy_on_device_title">기기에만 저장되는 정보</string>
    <string name="privacy_on_device_body">좋아하는 주제, 즐겨찾기 목록, 청취 기록과 재생 위치, 설정. 앱을 삭제하거나 앱 데이터를 지우면 모두 삭제돼요.</string>
    <string name="privacy_choices_title">공유할 정보는 직접 선택하세요</string>
    <string name="privacy_analytics_title">익명 사용 통계</string>
    <string name="privacy_analytics_body">열어 본 화면, 사용한 기능, 앱 및 운영체제 버전이 Google Firebase Analytics로 전송돼요. 목적: 어떤 기능이 유용한지 파악해 앱을 개선하기 위해서예요. 이름이나 전화번호와 연결되지 않아요.</string>
    <string name="privacy_crash_title">오류 보고서</string>
    <string name="privacy_crash_body">앱에 오류가 발생하면 오류 세부 정보, 기기 모델, Android 버전, 무작위 설치 ID가 Google Firebase Crashlytics로 전송돼요. 목적: 버그를 더 빨리 찾아 수정하기 위해서예요.</string>
    <string name="privacy_rights">동의는 언제든지 설정에서 철회할 수 있으며, 지원 이메일을 통해 내 데이터의 열람이나 삭제를 요청할 수 있어요. 동의하지 않아도 모든 기능을 사용할 수 있어요.</string>
    <string name="privacy_read_policy">개인정보 처리방침 전문 보기</string>
    <string name="privacy_accept_all">둘 다 공유에 동의</string>
    <string name="privacy_save_choices">선택 저장</string>
    <string name="privacy_continue_without">공유하지 않고 계속하기</string>
    <string name="privacy_footer">어느 버튼을 누르든 위 정보를 읽었음을 확인하는 것으로 간주돼요. 선택은 명시된 목적에만 적용돼요.</string>

    <!-- Topic picker -->
    <string name="topics_title">어떤 주제를 즐겨 듣나요?</string>
    <string name="topics_subtitle">주제를 3개 이상 고르면 TSPodcast가 취향에 맞는 프로그램을 추천해 드려요.</string>
    <string name="topics_search_hint">주제 검색</string>
    <string name="topics_popular">인기</string>
    <string name="topics_all">전체 주제</string>
    <string name="topics_progress">%1$d/3 선택됨</string>
    <string name="topics_selected">선택한 주제: %1$d</string>
    <string name="topics_continue">계속</string>
    <string name="topics_need_more">%1$d개 더 선택하세요</string>
    <string name="topics_empty">일치하는 주제가 없어요</string>
</resources>
