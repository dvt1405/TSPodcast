// Mẫu cho iosApp/Config/Secrets.xcconfig (file thật đã gitignore, KHÔNG commit).
//
//   cp iosApp/Config/Secrets.example.xcconfig iosApp/Config/Secrets.xcconfig
//
// rồi điền giá trị PodcastIndex (nguồn hiện tại: securedToken/src/main/cpp/securedtoken.cpp).
// Info.plist map 4 key này qua $(PODCASTINDEX_*); để trống thì app hiện
// "Thiếu cấu hình PodcastIndex (Secrets.xcconfig)" thay vì gọi API.
//
// Bẫy xcconfig: "//" mở đầu comment, nên phần sau "//" của URL bị cắt.
// Viết URL dạng https:/$()/api.example.org/path ($() là biến rỗng, sau khi expand thành https://).

PODCASTINDEX_API_KEY =
PODCASTINDEX_API_SECRET =
PODCASTINDEX_BASE_URL =
PODCASTINDEX_USER_AGENT =
