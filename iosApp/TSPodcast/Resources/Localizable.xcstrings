    "detail.hide.confirmMessage" : {
      "comment" : "Message of the hide confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sendung erscheint auf diesem Gerät nicht mehr in Entdecken und Suchen. Du kannst sie unter Einstellungen → Ausgeblendete Sendungen wieder einblenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This show will no longer appear in Discover and Search on this device. You can unhide it in Settings → Hidden shows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este programa dejará de aparecer en Descubrir y Buscar en este dispositivo. Puedes volver a mostrarlo en Ajustes → Programas ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette émission n’apparaîtra plus dans Découvrir et Rechercher sur cet appareil. Vous pouvez la réafficher dans Réglages → Émissions masquées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह शो इस डिवाइस पर एक्सप्लोर करें और खोजें में अब नहीं दिखेगा। आप इसे सेटिंग्स → छिपाए गए शो में जाकर फिर से दिखा सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acara ini tidak akan muncul lagi di Jelajahi dan Cari di perangkat ini. Anda dapat menampilkannya lagi di Pengaturan → Acara tersembunyi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo programma non apparirà più in Scopri e Cerca su questo dispositivo. Puoi mostrarlo di nuovo in Impostazioni → Programmi nascosti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この番組はこのデバイスの「見つける」と「検索」に表示されなくなります。設定 → 非表示の番組 で再表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로그램은 이 기기의 둘러보기와 검색에 더 이상 표시되지 않습니다. 설정 → 숨긴 프로그램에서 다시 표시할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit programma verschijnt op dit apparaat niet meer in Ontdek en Zoek. Je kunt het weer tonen via Instellingen → Verborgen programma's."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten podcast nie będzie już widoczny w Odkrywaj i Szukaj na tym urządzeniu. Możesz go przywrócić w Ustawienia → Ukryte podcasty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este programa não aparecerá mais em Descobrir e Buscar neste dispositivo. Você pode reexibi-lo em Ajustes → Programas ocultos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här programmet visas inte längre i Upptäck och Sök på den här enheten. Du kan visa det igen i Inställningar → Dolda program."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu program artık bu cihazda Keşfet ve Ara bölümlerinde görünmeyecek. Ayarlar → Gizlenen programlar bölümünden yeniden gösterebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show sẽ không còn xuất hiện ở Khám phá và Tìm kiếm trên máy này. Bạn có thể bỏ ẩn trong Cài đặt → Show đã ẩn."
          }
        }
      }
