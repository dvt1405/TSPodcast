    "consent.footnote" : {
      "comment" : "PLACEHOLDER waiting for the lawyer (N11, PDPL): footnote of the privacy sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst deine Auswahl jederzeit unter Einstellungen → Datenschutz ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change your choice at any time in Settings → Privacy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiar tu elección cuando quieras en Ajustes → Privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez modifier votre choix à tout moment dans Réglages → Confidentialité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अपनी पसंद कभी भी सेटिंग्स → प्राइवेसी में बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda dapat mengubah pilihan kapan saja di Pengaturan → Privasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi cambiare la tua scelta in qualsiasi momento in Impostazioni → Privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択内容はいつでも 設定 → プライバシー で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택은 언제든지 설정 → 개인정보 보호에서 변경할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt je keuze op elk moment wijzigen in Instellingen → Privacy."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz zmienić swój wybór w dowolnej chwili w Ustawienia → Prywatność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode mudar sua escolha a qualquer momento em Ajustes → Privacidade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ändra ditt val när som helst i Inställningar → Integritet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçiminizi istediğiniz zaman Ayarlar → Gizlilik bölümünden değiştirebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể đổi lựa chọn bất cứ lúc nào trong Cài đặt → Quyền riêng tư."
          }
        }
      }
    },
    "consent.intro" : {
      "comment" : "PLACEHOLDER waiting for the lawyer (N11, PDPL): intro of the privacy sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSPodcast erfasst nur, was für den Betrieb nötig ist. Nutzungsanalyse und Absturzberichte helfen uns, die App zu verbessern, und werden nur mit deiner Zustimmung aktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSPodcast only collects what it needs to run. Usage analytics and crash reports help us improve the app and are only turned on if you agree."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSPodcast solo recopila lo que necesita para funcionar. El análisis de uso y los informes de fallos nos ayudan a mejorar la app y solo se activan si das tu consentimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSPodcast ne collecte que ce dont il a besoin pour fonctionner. Les statistiques d’utilisation et les rapports de plantage nous aident à améliorer l’app et ne sont activés qu’avec votre accord."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSPodcast सिर्फ़ वही जानकारी इकट्ठा करता है जो ऐप चलाने के लिए ज़रूरी है। इस्तेमाल का विश्लेषण और क्रैश रिपोर्ट ऐप को बेहतर बनाने में हमारी मदद करते हैं और सिर्फ़ आपकी सहमति से ही चालू होते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSPodcast hanya mengumpulkan yang diperlukan agar aplikasi berjalan. Analitik penggunaan dan laporan error membantu kami menyempurnakan aplikasi dan hanya diaktifkan jika Anda setuju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSPodcast raccoglie solo ciò che serve per funzionare. L’analisi di utilizzo e le segnalazioni di arresti anomali ci aiutano a migliorare l’app e vengono attivate solo con il tuo consenso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSPodcastは動作に必要な情報だけを収集します。利用状況の分析とクラッシュレポートはアプリの改善に役立つもので、同意した場合にのみオンになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSPodcast는 앱 실행에 필요한 정보만 수집합니다. 사용 분석과 충돌 보고서는 앱 개선에 도움이 되며, 동의한 경우에만 켜집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSPodcast verzamelt alleen wat nodig is om te werken. Gebruiksanalyse en crashrapporten helpen ons de app te verbeteren en staan alleen aan als je daarmee instemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSPodcast zbiera tylko to, czego potrzebuje do działania. Analityka użytkowania i raporty o awariach pomagają nam ulepszać aplikację i są włączane tylko za Twoją zgodą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O TSPodcast coleta apenas o necessário para funcionar. A análise de uso e os relatórios de falhas nos ajudam a melhorar o app e só são ativados se você concordar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSPodcast samlar bara in det som behövs för att fungera. Användningsanalys och kraschrapporter hjälper oss att förbättra appen och slås bara på om du godkänner det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSPodcast yalnızca çalışması için gerekenleri toplar. Kullanım analizi ve çökme raporları uygulamayı geliştirmemize yardımcı olur ve yalnızca onay verirseniz açılır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSPodcast chỉ thu thập những gì cần để app chạy. Phân tích sử dụng và báo cáo sự cố giúp chúng tôi cải thiện app, và chỉ bật khi bạn đồng ý."
          }
        }
      }
    },
    "consent.necessary.detail" : {
      "comment" : "PLACEHOLDER waiting for the lawyer (N11, PDPL): explanation of the necessary group.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immer aktiv: der Betrieb der App, die Aktualisierung des Spam-Inhaltsfilters (Remote Config) und eine zufällige Installations-ID, die nicht mit deinem Gerät oder deiner Identität verknüpft ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always on: running the app, updating the spam content filter (Remote Config) and a random install ID that is not tied to your device or identity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre activo: el funcionamiento de la app, la actualización del filtro de contenido spam (Remote Config) y un ID de instalación aleatorio que no está vinculado a tu dispositivo ni a tu identidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours activé \u0001 le fonctionnement de l’app, la mise à jour du filtre de contenus indésirables (Remote Config) et un identifiant d’installation aléatoire, lié ni à votre appareil ni à votre identité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हमेशा चालू: ऐप चलाना, स्पैम कॉन्टेंट फ़िल्टर अपडेट करना (Remote Config) और एक रैंडम इंस्टॉल ID, जो आपके डिवाइस या पहचान से जुड़ी नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selalu aktif: menjalankan aplikasi, memperbarui filter konten spam (Remote Config), dan ID instalasi acak yang tidak terkait dengan perangkat atau identitas Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre attivo: il funzionamento dell’app, l’aggiornamento del filtro dei contenuti spam (Remote Config) e un ID di installazione casuale, non collegato al tuo dispositivo né alla tua identità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常にオン: アプリの動作、スパムコンテンツフィルタの更新(Remote Config)、およびデバイスや個人とは結び付かないランダムなインストールIDです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항상 켜짐: 앱 실행, 스팸 콘텐츠 필터 업데이트(Remote Config), 그리고 기기나 신원과 연결되지 않는 무작위 설치 ID."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altijd aan: het laten werken van de app, het bijwerken van het spamfilter voor content (Remote Config) en een willekeurige installatie-ID die niet aan je apparaat of identiteit is gekoppeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawsze włączone: działanie aplikacji, aktualizacja filtra treści spamowych (Remote Config) oraz losowy identyfikator instalacji, niepowiązany z Twoim urządzeniem ani tożsamością."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre ativo: o funcionamento do app, a atualização do filtro de conteúdo spam (Remote Config) e um ID de instalação aleatório, que não está vinculado ao seu dispositivo nem à sua identidade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alltid på: att appen fungerar, uppdatering av spamfiltret för innehåll (Remote Config) och ett slumpmässigt installations-ID som inte är kopplat till din enhet eller din identitet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her zaman açık: uygulamanın çalışması, spam içerik filtresinin güncellenmesi (Remote Config) ve cihazınıza ya da kimliğinize bağlı olmayan rastgele bir kurulum kimliği."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luôn bật: để app chạy, cập nhật danh sách lọc nội dung spam (Remote Config) và một mã cài đặt ngẫu nhiên, không gắn với thiết bị hay danh tính của bạn."
          }
        }
      }
    },
