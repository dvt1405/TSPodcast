    "notifications.prompt.message" : {
      "comment" : "Body of the one-time notification prompt.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur wenn neue Podcasts erscheinen. Du kannst das jederzeit in den Einstellungen deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only when new podcasts arrive. You can turn this off anytime in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cuando lleguen podcasts nuevos. Puedes desactivarlo cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement quand de nouveaux podcasts arrivent. Vous pouvez désactiver cette option à tout moment dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ तब, जब नए पॉडकास्ट आएँ। आप इसे कभी भी सेटिंग्स में बंद कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya saat ada podcast baru. Anda dapat menonaktifkannya kapan saja di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo quando arrivano nuovi podcast. Puoi disattivarle in qualsiasi momento in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいポッドキャストが届いたときだけ通知します。設定からいつでもオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 팟캐스트가 올라올 때만 알려 드립니다. 설정에서 언제든지 끌 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen als er nieuwe podcasts zijn. Je kunt dit altijd uitzetten in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko gdy pojawią się nowe podcasty. Możesz to wyłączyć w dowolnej chwili w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só quando chegarem podcasts novos. Você pode desativar quando quiser em Ajustes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara när nya poddar kommer. Du kan stänga av det när som helst i Inställningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca yeni podcastler geldiğinde. Bunu istediğiniz zaman Ayarlar'dan kapatabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ gửi khi có podcast mới. Bạn có thể tắt bất cứ lúc nào trong Cài đặt."
          }
        }
      }
    },
