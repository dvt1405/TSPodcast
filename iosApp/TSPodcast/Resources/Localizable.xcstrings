    "consent.analytics.detail" : {
      "comment" : "PLACEHOLDER waiting for the lawyer (N11, PDPL): explanation of usage analytics.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyme Zahlen dazu, wie die App genutzt wird (Bildschirme, Funktionen). Deine Suchanfragen werden nie gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonymous figures on how the app is used (screens, features). What you search for is never sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datos anónimos sobre cómo se usa la app (pantallas, funciones). Nunca se envía lo que buscas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des statistiques anonymes sur l’utilisation de l’app (écrans, fonctionnalités). Vos recherches ne sont jamais envoyées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप के इस्तेमाल (स्क्रीन, फ़ीचर) के बारे में गुमनाम आँकड़े। आप जो खोजते हैं, वह कभी नहीं भेजा जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angka anonim tentang cara aplikasi digunakan (layar, fitur). Apa yang Anda cari tidak pernah dikirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dati anonimi su come viene usata l’app (schermate, funzioni). Le tue ricerche non vengono mai inviate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの使われ方(画面、機能)に関する匿名の統計です。検索した内容は送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 사용 방식(화면, 기능)에 대한 익명 통계입니다. 검색한 내용은 절대 전송되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonieme cijfers over hoe de app wordt gebruikt (schermen, functies). Wat je zoekt, wordt nooit verstuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonimowe dane o tym, jak używana jest aplikacja (ekrany, funkcje). Twoje wyszukiwania nigdy nie są wysyłane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados anônimos sobre como o app é usado (telas, recursos). O que você pesquisa nunca é enviado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonym statistik om hur appen används (skärmar, funktioner). Det du söker efter skickas aldrig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın nasıl kullanıldığına dair anonim veriler (ekranlar, özellikler). Aramalarınız asla gönderilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số liệu ẩn danh về cách app được dùng (màn hình, tính năng). Không gửi nội dung bạn tìm kiếm."
          }
        }
      }
    },
