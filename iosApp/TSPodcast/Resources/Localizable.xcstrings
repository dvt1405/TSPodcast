    "shortcut.continue.description" : {
      "comment" : "Shortcut \"Continue listening\": description in the Shortcuts app.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt die Folge, die du gehört hast, dort weiter, wo du aufgehört hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays the episode you were listening to, from where you left off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce el episodio que estabas escuchando desde donde lo dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit l’épisode que vous écoutiez, là où vous vous êtes arrêté."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो एपिसोड आप सुन रहे थे, उसे वहीं से चलाता है जहाँ आपने छोड़ा था।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memutar episode yang sedang Anda dengarkan, dari posisi terakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce l’episodio che stavi ascoltando, dal punto in cui eri rimasto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聴いていたエピソードを、中断した位置から再生します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "듣던 에피소드를 멈춘 지점부터 재생합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt de aflevering waar je naar luisterde verder af vanaf waar je was gebleven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarza odcinek, którego słuchałeś, od miejsca, w którym przerwałeś."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz o episódio que você estava ouvindo, de onde você parou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spelar avsnittet du lyssnade på från där du slutade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinlediğiniz bölümü kaldığınız yerden oynatır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phát tiếp tập bạn đang nghe dở, từ vị trí đã lưu."
          }
        }
      }
    },
