    "shortcut.sleepTimer.description" : {
      "comment" : "Shortcut \"Set sleep timer\": description in the Shortcuts app.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppt die Wiedergabe nach der gewählten Anzahl Minuten (1–180)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops playback after the number of minutes you choose (1–180)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detiene la reproducción tras los minutos que elijas (1–180)."
