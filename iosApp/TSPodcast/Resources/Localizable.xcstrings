    "consent.crash.detail" : {
      "comment" : "PLACEHOLDER waiting for the lawyer (N11, PDPL): explanation of crash reports.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn in der App ein Fehler auftritt, werden technische Details dazu gesendet, damit wir ihn beheben können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the app runs into an error, send technical details about it so we can fix it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando la app tiene un error, envía datos técnicos sobre él para que podamos corregirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand l’app rencontre une erreur, des informations techniques sur celle-ci sont envoyées pour que nous puissions la corriger."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब ऐप में कोई गड़बड़ी होती है, तो उसकी तकनीकी जानकारी भेजी जाती है ताकि हम उसे ठीक कर सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat aplikasi mengalami error, kirim detail teknis tentang error tersebut agar kami bisa memperbaikinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando l’app incontra un errore, invia informazioni tecniche sull’errore così possiamo correggerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリでエラーが起きたときに、修正のためその技術的な情報を送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱에 오류가 발생하면 문제를 해결할 수 있도록 오류에 대한 기술 정보를 전송합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de app een fout tegenkomt, worden technische gegevens daarover verstuurd zodat we de fout kunnen oplossen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy w aplikacji wystąpi błąd, wysyłane są dane techniczne na jego temat, abyśmy mogli go naprawić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o app encontra um erro, envia detalhes técnicos sobre ele para que possamos corrigi-lo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När appen stöter på ett fel skickas tekniska uppgifter om felet så att vi kan åtgärda det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamada bir hata oluştuğunda, düzeltebilmemiz için hatayla ilgili teknik bilgiler gönderilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi app gặp lỗi, gửi thông tin kỹ thuật về lỗi đó để chúng tôi sửa."
          }
        }
      }
    },
