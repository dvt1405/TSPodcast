    "consent.acceptAll" : {
      "comment" : "PLACEHOLDER waiting for the lawyer (N11, PDPL): button: allow analytics and crash reports.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
