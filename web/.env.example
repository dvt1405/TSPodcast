# Copy to .env.local (gitignored) and fill in. All of these are read on the
# server only; nothing here is sent to the browser except NEXT_PUBLIC_* values.

# --- Required: Podcast Index (https://api.podcastindex.org/) ---
# Without these the site still runs and shows a setup notice instead of content.
# IMPORTANT: Next.js expands "$VAR" inside .env files. If a value contains "$",
# write it as "\$" (otherwise the secret is silently truncated and every
# request fails with 401). Hosting dashboards (Vercel, etc.) need no escaping.
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
# Optional User-Agent sent to Podcast Index (the Android app sends TSSPodcast/Android).
# PODCASTINDEX_USER_AGENT=TSSPodcast/Web

# --- Optional: AI features (summary, episode Q&A, natural-language search) ---
# Leave empty to disable AI; the UI hides the AI panels and /api/ai/* returns 503.
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5-5.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Set to "off" if you route through a gateway that rejects the server-side
# refusal-fallback beta.
# ANTHROPIC_FALLBACKS=off

# --- Site ---
# Canonical origin used for canonical URLs, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# UI language for this deployment: vi (default) or en.
NEXT_PUBLIC_SITE_LOCALE=vi
# Set to 1 on preview/staging deployments to disallow all crawling.
# SITE_NOINDEX=1
# Google Search Console HTML-tag verification token.
# GOOGLE_SITE_VERIFICATION=

# --- App distribution / ads (docs/in-progress/plans/seo-web-dashboard.md §A.9-A.10) ---
# Optional override for app-ads.txt; separate several lines with \n.
# Defaults to the TSPodcast publisher record below.
# APP_ADS_TXT=google.com, pub-8696388065064767, DIRECT, f08c47fec0942fa0
# SHA-256 signing-cert fingerprints for /.well-known/assetlinks.json, comma-separated.
# ANDROID_CERT_SHA256=AA:BB:...
